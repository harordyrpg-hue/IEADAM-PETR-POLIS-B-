rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection health check
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 1. User Profiles & Team RBAC
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Media Files & Folders (Shared Workspace: all users can see, upload, download and modify in real-time)
    match /files/{fileId} {
      allow read: if true;
      allow write: if true;
    }

    match /folders/{folderId} {
      allow read: if true;
      allow write: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /shares/{shareId} {
      allow read: if true;
      allow write: if true;
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /file_data/{fileId} {
      allow read: if true;
      allow write: if true;
    }

    match /file_chunks/{chunkId} {
      allow read: if true;
      allow write: if true;
    }

    // Team Schedule, Tasks & Collaborative Notes (Real-time team workspace)
    match /team_tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    match /team_notes/{noteId} {
      allow read: if true;
      allow write: if true;
    }

    // ==================================================
    // 3. PUBLIC CHURCH PAGE & CHURCH MANAGEMENT
    // ==================================================
    match /church_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_albums/{albumId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_downloads/{downloadId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Church Media Financial System (Livro Caixa, Contas & Previsões)
    match /financial_records/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    match /financial_bills/{billId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Public Registration Events & Guest Registrations (no login required for guests)
    match /public_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /event_registrations/{registrationId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Member Attendance & Roll Call System
    match /attendance_departments/{departmentId} {
      allow read: if true;
      allow write: if true;
    }

    match /attendance_members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    match /attendance_calls/{callId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Secretariat - Baptism Form Settings & Public Registrations
    match /baptism_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /baptism_registrations/{registrationId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
