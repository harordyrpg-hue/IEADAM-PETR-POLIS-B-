rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^(pedro\\.martinss225|emillycampos308)@gmail\\.com$')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    // 1. User Profiles & Team RBAC
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Media Files & Folders (Shared Workspace: all users can see, upload, download and modify in real-time)
    match /files/{fileId} {
      allow read: if true;
      allow write: if true;
    }

    match /folders/{folderId} {
      allow read: if true;
      allow write: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /shares/{shareId} {
      allow read: if true;
      allow write: if true;
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /file_data/{fileId} {
      allow read: if true;
      allow write: if true;
    }

    match /file_chunks/{chunkId} {
      allow read: if true;
      allow write: if true;
    }

    // Team Schedule, Tasks & Collaborative Notes (Real-time team workspace)
    match /team_tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    match /team_notes/{noteId} {
      allow read: if true;
      allow write: if true;
    }

    // ==================================================
    // 3. PUBLIC CHURCH PAGE & CHURCH MANAGEMENT
    // ==================================================

    match /church_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_albums/{albumId} {
      allow read: if true;
      allow write: if true;
    }

    match /church_downloads/{downloadId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
