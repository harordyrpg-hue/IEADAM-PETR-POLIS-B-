rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Connection health check (used on startup before login)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 1. User Profiles & Team RBAC (Authenticated team only)
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /admins/{adminId} {
      allow read, write: if isSignedIn();
    }

    // 2. Media Files & Folders
    // Read allowed for signed-in team AND public #share= links; writes require authentication
    match /files/{fileId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /folders/{folderId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /shares/{shareId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /activities/{activityId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read, write: if isSignedIn();
    }

    match /file_data/{fileId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /file_chunks/{chunkId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Team Schedule, Tasks & Collaborative Notes (Real-time team workspace)
    match /team_tasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    match /team_notes/{noteId} {
      allow read, write: if isSignedIn();
    }

    // ==================================================
    // 3. PUBLIC CHURCH PAGE & CHURCH MANAGEMENT
    // ==================================================
    match /church_settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /church_announcements/{announcementId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /church_events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /church_articles/{articleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /church_albums/{albumId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /church_downloads/{downloadId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
      allow update: if isSignedIn() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount']);
    }

    // 4. Church Media Financial System (Authenticated team only)
    match /financial_records/{recordId} {
      allow read, write: if isSignedIn();
    }

    match /financial_bills/{billId} {
      allow read, write: if isSignedIn();
    }

    // 5. Public Registration Events & Guest Registrations (no login required for guests)
    match /public_events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /event_registrations/{registrationId} {
      allow read, create: if true;
      allow update, delete: if isSignedIn();
    }

    // 6. Member Attendance & Roll Call System (Authenticated team only)
    match /attendance_departments/{departmentId} {
      allow read, write: if isSignedIn();
    }

    match /attendance_members/{memberId} {
      allow read, write: if isSignedIn();
    }

    match /attendance_calls/{callId} {
      allow read, write: if isSignedIn();
    }
  }
}
