{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with roles and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["super_admin", "media_admin", "media_member"] },
        "roleLabel": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "avatar": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "Folder": {
      "title": "Folder",
      "description": "Folder hierarchy for organizing media assets",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "parentId": { "type": "string", "maxLength": 128 },
        "color": { "type": "string", "maxLength": 30 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "isFavorite": { "type": "boolean" },
        "inTrash": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerUid", "inTrash"]
    },
    "FileRecord": {
      "title": "FileRecord",
      "description": "Metadata for uncompressed original media files in Cloud Storage",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 255 },
        "originalName": { "type": "string", "maxLength": 255 },
        "extension": { "type": "string", "maxLength": 20 },
        "mimeType": { "type": "string", "maxLength": 100 },
        "size": { "type": "number" },
        "type": { "type": "string", "enum": ["photo", "video", "art", "audio", "document", "archive", "other"] },
        "storagePath": { "type": "string", "maxLength": 500 },
        "downloadUrl": { "type": "string", "maxLength": 2000 },
        "thumbnailUrl": { "type": "string", "maxLength": 2000 },
        "folderId": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 120 },
        "isFavorite": { "type": "boolean" },
        "inTrash": { "type": "boolean" },
        "trashedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array" },
        "resolution": { "type": "string", "maxLength": 50 },
        "duration": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "size", "type", "storagePath", "ownerUid", "inTrash"]
    },
    "ChurchEvent": {
      "title": "ChurchEvent",
      "description": "Church media event (culto, conferência, batismo)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "date": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 100 },
        "coverUrl": { "type": "string", "maxLength": 2000 },
        "responsibles": { "type": "array" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "date", "category"]
    },
    "ShareLink": {
      "title": "ShareLink",
      "description": "Secure sharing links for media assets",
      "type": "object",
      "properties": {
        "token": { "type": "string", "maxLength": 128 },
        "resourceType": { "type": "string", "enum": ["file", "folder", "event"] },
        "resourceId": { "type": "string", "maxLength": 128 },
        "resourceName": { "type": "string", "maxLength": 255 },
        "allowDownload": { "type": "boolean" },
        "requireAuth": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "resourceType", "resourceId", "resourceName", "allowDownload"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Audit activity log entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "action": { "type": "string", "maxLength": 50 },
        "actionLabel": { "type": "string", "maxLength": 150 },
        "targetType": { "type": "string", "maxLength": 50 },
        "targetName": { "type": "string", "maxLength": 255 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "action", "actionLabel", "targetName"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Church system configurations and storage quota",
      "type": "object",
      "properties": {
        "churchName": { "type": "string", "maxLength": 150 },
        "churchSubtitle": { "type": "string", "maxLength": 200 },
        "storageEngine": { "type": "string", "maxLength": 50 },
        "totalQuotaBytes": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["churchName"]
    },
    "TeamTask": {
      "title": "TeamTask",
      "description": "Team schedule assignment, task or duty",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 50 },
        "eventId": { "type": "string", "maxLength": 128 },
        "eventName": { "type": "string", "maxLength": 200 },
        "assignedToUid": { "type": "string", "maxLength": 128 },
        "assignedToName": { "type": "string", "maxLength": 120 },
        "assignedToEmail": { "type": "string", "maxLength": 150 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "dueTime": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "maxLength": 20 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "isPrivate": { "type": "boolean" },
        "completedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "assignedToUid", "dueDate", "status"]
    },
    "TeamNote": {
      "title": "TeamNote",
      "description": "Collaborative media team note",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "authorUid"]
    },
    "FinancialTransaction": {
      "title": "FinancialTransaction",
      "description": "Church media cash flow record (entrada / saida)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["entrada", "saida"] },
        "title": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "counterparty": { "type": "string", "maxLength": 200 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["confirmado", "pendente", "cancelado"] },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "amount", "date", "description", "counterparty", "status"]
    },
    "FinancialBill": {
      "title": "FinancialBill",
      "description": "Accounts payable, accounts receivable, and future planned expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["a_pagar", "a_receber"] },
        "title": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "counterparty": { "type": "string", "maxLength": 200 },
        "dueDate": { "type": "string", "maxLength": 30 },
        "hasNoForecast": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["baixa", "media", "alta", "urgente"] },
        "status": { "type": "string", "enum": ["pendente", "pago", "cancelado"] },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "amount", "description", "counterparty", "status"]
    },
    "PublicRegistrationEvent": {
      "title": "PublicRegistrationEvent",
      "description": "Public church event with customizable registration form",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "date": { "type": "string", "maxLength": 30 },
        "time": { "type": "string", "maxLength": 30 },
        "location": { "type": "string", "maxLength": 300 },
        "bannerUrl": { "type": "string", "maxLength": 2000 },
        "themeColor": { "type": "string", "maxLength": 30 },
        "rulesAndNotes": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["aberto", "encerrado", "em_breve"] },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "date", "location", "status"]
    },
    "EventRegistration": {
      "title": "EventRegistration",
      "description": "Guest attendee registration record with QR code",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "eventName": { "type": "string", "maxLength": 200 },
        "fullName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "church": { "type": "string", "maxLength": 150 },
        "area": { "type": "string", "maxLength": 100 },
        "responsibleLeader": { "type": "string", "maxLength": 150 },
        "responsiblePastor": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["confirmada", "presente", "cancelada"] },
        "registeredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "eventName", "fullName", "phone", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User accounts and access control profiles"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Admin access markers"
    },
    "/folders/{folderId}": {
      "schema": { "$ref": "#/entities/Folder" },
      "description": "Folder hierarchy"
    },
    "/files/{fileId}": {
      "schema": { "$ref": "#/entities/FileRecord" },
      "description": "File records storing Cloud Storage references and metadata"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/ChurchEvent" },
      "description": "Church media events"
    },
    "/shares/{shareId}": {
      "schema": { "$ref": "#/entities/ShareLink" },
      "description": "Shared access tokens"
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "Audit trail log"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "System settings document"
    },
    "/church_settings/{docId}": {
      "schema": { "$ref": "#/entities/ChurchProfile" },
      "description": "Public church profile and institutional information"
    },
    "/church_announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/ChurchAnnouncement" },
      "description": "Church public announcements and bulletins"
    },
    "/church_events/{eventId}": {
      "schema": { "$ref": "#/entities/ChurchPublicEvent" },
      "description": "Church public service schedule and upcoming events"
    },
    "/church_articles/{articleId}": {
      "schema": { "$ref": "#/entities/ChurchArticle" },
      "description": "Church articles and devotionals"
    },
    "/church_albums/{albumId}": {
      "schema": { "$ref": "#/entities/ChurchAlbum" },
      "description": "Church photo albums and YouTube video links"
    },
    "/church_downloads/{downloadId}": {
      "schema": { "$ref": "#/entities/ChurchDownload" },
      "description": "Church downloadable public study materials, bulletins, and sheet music"
    },
    "/team_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TeamTask" },
      "description": "Team tasks and schedule assignments"
    },
    "/team_notes/{noteId}": {
      "schema": { "$ref": "#/entities/TeamNote" },
      "description": "Team collaborative board notes"
    },
    "/financial_records/{recordId}": {
      "schema": { "$ref": "#/entities/FinancialTransaction" },
      "description": "Church financial cash flow transactions (entradas e saídas de caixa)"
    },
    "/financial_bills/{billId}": {
      "schema": { "$ref": "#/entities/FinancialBill" },
      "description": "Accounts payable, accounts receivable, and future planned expenses"
    },
    "/public_events/{eventId}": {
      "schema": { "$ref": "#/entities/PublicRegistrationEvent" },
      "description": "Public events with customizable registration forms"
    },
    "/event_registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/EventRegistration" },
      "description": "Guest registrations with ticket and QR code"
    }
  }
}
